{
  "manifest_version": 3,
  "name": "Muz0fondDownloader",
  "description": "Download file from muz0fond.fm while play button are pressed",
  "version": "1.0.2",
  "author": "DevXeni",
  "homepage_url": "https://github.com/DevXeni/dwnmuzofnd",
  "browser_specific_settings": {
      "gecko": {
        "id": "@Muz0fondDownloader.DevXeni",
        "data_collection_permissions": {
          "required": ["none"]
        },
        "update_url": "https://github.com/DevXeni/dwnmuzofnd/blob/master/updates.json"
      }     
  }, 
  "icons": {
    "48": "icons/logo.png"
  },

  "permissions": ["downloads"],

  "background": {
    "scripts": ["background.js"]
  },
  
  "content_scripts": [
    {
      "matches": ["*://*.muzofond.fm/*"],
      "js": ["content.js"]
    }
  ]
}